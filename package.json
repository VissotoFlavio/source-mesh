{
  "name": "@vissotoflavio/source-mesh",
  "version": "0.0.0",
  "description": "Local-first structural graph tooling for source code",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "bin": {
    "sourcemesh": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import=tsx --test test/smoke.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "pack:check": "npm pack --dry-run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run pack:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
