{
  "name": "@vissotoflavio/source-mesh",
  "version": "0.1.0-beta.2",
  "description": "Local-first structural graph tooling for source code",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0 <23 || >=24.0.0 <25"
  },
  "bin": {
    "sourcemesh": "./dist/cli.js"
  },
  "files": [
    "dist",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/Microsoft.CodeAnalysis.CSharp.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/Microsoft.CodeAnalysis.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/sourcemesh-roslyn.deps.json",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/sourcemesh-roslyn.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/sourcemesh-roslyn.integrity.json",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/sourcemesh-roslyn.runtimeconfig.json",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/cs/Microsoft.CodeAnalysis.CSharp.resources.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/cs/Microsoft.CodeAnalysis.resources.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/de/Microsoft.CodeAnalysis.CSharp.resources.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/de/Microsoft.CodeAnalysis.resources.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/es/Microsoft.CodeAnalysis.CSharp.resources.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/es/Microsoft.CodeAnalysis.resources.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/fr/Microsoft.CodeAnalysis.CSharp.resources.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/fr/Microsoft.CodeAnalysis.resources.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/it/Microsoft.CodeAnalysis.CSharp.resources.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/it/Microsoft.CodeAnalysis.resources.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/ja/Microsoft.CodeAnalysis.CSharp.resources.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/ja/Microsoft.CodeAnalysis.resources.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/ko/Microsoft.CodeAnalysis.CSharp.resources.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/ko/Microsoft.CodeAnalysis.resources.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/pl/Microsoft.CodeAnalysis.CSharp.resources.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/pl/Microsoft.CodeAnalysis.resources.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/pt-BR/Microsoft.CodeAnalysis.CSharp.resources.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/pt-BR/Microsoft.CodeAnalysis.resources.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/ru/Microsoft.CodeAnalysis.CSharp.resources.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/ru/Microsoft.CodeAnalysis.resources.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/tr/Microsoft.CodeAnalysis.CSharp.resources.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/tr/Microsoft.CodeAnalysis.resources.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/zh-Hans/Microsoft.CodeAnalysis.CSharp.resources.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/zh-Hans/Microsoft.CodeAnalysis.resources.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/zh-Hant/Microsoft.CodeAnalysis.CSharp.resources.dll",
    "tools/sourcemesh-roslyn/bin/Release/net10.0/zh-Hant/Microsoft.CodeAnalysis.resources.dll",
    "THIRD-PARTY-NOTICES.md"
  ],
  "bundledDependencies": [
    "@modelcontextprotocol/server",
    "typescript"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "offline:check": "npm run build && node --import ./scripts/deny-network.mjs --import tsx --test test/project-loader.offline.test.ts && node --import ./scripts/deny-network.mjs ./dist/cli.js --help && npm run e2e:check && node --import tsx --test test/mcp-stdio.integration.test.ts",
    "csharp:build": "dotnet build tools/sourcemesh-roslyn/sourcemesh-roslyn.csproj --configuration Release --no-restore",
    "csharp:offline:check": "npm run csharp:build && node --import ./scripts/deny-network.mjs --import tsx ./scripts/check-csharp-offline.mjs",
    "accept:velocy": "node --import ./scripts/deny-network.mjs --import tsx scripts/check-velocy-local.mjs",
    "e2e:check": "node --import tsx --test test/e2e/workflow.e2e.ts",
    "measure:e2e": "node scripts/measure-e2e.mjs",
    "prepack": "npm run build && node scripts/generate-helper-integrity.mjs && node scripts/check-package.mjs",
    "pack:check": "npm pack --dry-run",
    "package:check": "npm run build && node scripts/generate-helper-integrity.mjs && node scripts/check-packaged-install.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run offline:check && npm run pack:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript-eslint": "8.72.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "typescript": "6.0.3"
  }
}
