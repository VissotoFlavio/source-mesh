<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Library.csproj" />
    <Compile Remove="src\Library\Contracts.cs" />
    <Compile Remove="src\Library\Types.cs" />
    <Compile Remove="src\App\Explicit.cs" />
    <Compile Remove="src\App\Generated\**" />
    <Compile Include="src\App\Explicit.cs" Link="Linked\Explicit.cs" />
    <Content Remove="src\App\Generated\**" />
    <EmbeddedResource Remove="src\App\Generated\**" />
    <None Remove="src\App\Generated\**" />
    <EmbeddedResource Include="data\resource.json" Link="Resources\resource.json" LogicalName="Synthetic.Resource" />
    <PackageReference Include="Synthetic.Package" Version="1.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
